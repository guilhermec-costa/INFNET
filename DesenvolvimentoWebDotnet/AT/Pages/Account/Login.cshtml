@page
@model AgenciaTurismo.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <h2>Use uma conta local para entrar.</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Credential.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="Usuário" />
                    <label asp-for="Credential.UserName" class="form-label"></label>
                    <span asp-validation-for="Credential.UserName" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Credential.Password" class="form-control" type="password" autocomplete="current-password" aria-required="true" placeholder="Senha" />
                    <label asp-for="Credential.Password" class="form-label"></label>
                    <span asp-validation-for="Credential.Password" class="text-danger"></span>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Entrar</button>
                </div>
            </form>
            <div class="mt-3">
                <p>Usuário de teste: <strong>admin</strong> | Senha de teste: <strong>123</strong></p>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}