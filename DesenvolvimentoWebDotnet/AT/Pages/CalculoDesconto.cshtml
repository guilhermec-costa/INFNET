@page
@model AgenciaTurismo.Pages.CalculoDescontoModel
@{
    ViewData["Title"] = "Cálculo de Desconto";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <div class="form-group">
        <label for="preco">Preço Original:</label>
        <input type="number" step="0.01" class="form-control" name="preco" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Calcular com Desconto</button>
</form>

@if (Model.PrecoComDesconto > 0)
{
    <h3 class="mt-3">Preço com Desconto: @Model.PrecoComDesconto.ToString("C")</h3>
}