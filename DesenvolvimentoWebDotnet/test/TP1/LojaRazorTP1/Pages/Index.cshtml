@page
@model LojaRazor.Pages.IndexModel
@{
    ViewData["Title"] = "Página Inicial";
}

<h1>Lista de Produtos</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Preço (R$)</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Produtos)
    {
        <tr>
            <td>@p.Nome</td>
            <td>@p.Preco.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>
